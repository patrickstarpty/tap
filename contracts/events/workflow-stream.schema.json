{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "eventId": {
      "title": "Eventid",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "nodeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Nodeid"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "parentNodeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parentnodeid"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projectid"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "sourceRuntime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourceruntime"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "taskId": {
      "title": "Taskid",
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "taskId",
    "sequence",
    "nodeId",
    "attempt",
    "kind",
    "payload",
    "occurredAt"
  ],
  "title": "WorkflowEventEnvelope",
  "type": "object"
}
