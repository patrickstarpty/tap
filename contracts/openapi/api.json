        "type": "object"
      },
      "FailureAnchor": {
        "additionalProperties": false,
        "properties": {
          "incidentId": {
            "minLength": 1,
            "title": "Incidentid",
            "type": "string"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
