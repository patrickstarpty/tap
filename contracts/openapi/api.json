  "info": {
    "title": "TAP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chats/{chat_id}/turns": {
      "post": {
        "description": "Reserve the public route until the durable turn workflow is implemented.",
        "operationId": "chat_create_turn",
        "parameters": [
          {
            "in": "path",
            "name": "chat_id",
            "required": true,
            "schema": {
              "title": "Chat Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatTurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatTurnAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "description": "RFC 9457 problem details returned by the public HTTP interface.",
                  "properties": {
                    "detail": {
                      "minLength": 1,
                      "title": "Detail",
                      "type": "string"
                    },
                    "instance": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Instance"
                    },
                    "status": {
                      "maximum": 599,
                      "minimum": 100,
                      "title": "Status",
                      "type": "integer"
                    },
                    "title": {
                      "minLength": 1,
                      "title": "Title",
                      "type": "string"
                    },
                    "type": {
                      "pattern": "^https://",
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                  ],
                  "title": "ProblemDetails",
                  "type": "object"
                }
              }
            },
            "description": "Request validation failed"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "description": "RFC 9457 problem details returned by the public HTTP interface.",
                  "properties": {
                    "detail": {
                      "minLength": 1,
                      "title": "Detail",
                      "type": "string"
                    },
                    "instance": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Instance"
                    },
                    "status": {
                      "maximum": 599,
                      "minimum": 100,
                      "title": "Status",
                      "type": "integer"
                    },
                    "title": {
                      "minLength": 1,
                      "title": "Title",
                      "type": "string"
                    },
                    "type": {
                      "pattern": "^https://",
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                  ],
                  "title": "ProblemDetails",
                  "type": "object"
                }
              }
            },
            "description": "Turn workflow not implemented"
          }
        },
        "summary": "Create Chat Turn"
      }
    }
  }
}
