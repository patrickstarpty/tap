# Local middleware images and loopback host ports
MYSQL_IMAGE=mysql:8.4.6
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=tap-root
MYSQL_DATABASE=tap
MYSQL_USER=tap
MYSQL_PASSWORD=tap

REDIS_IMAGE=redis:7.4.7
REDIS_PORT=6379

AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.35.0
AZURITE_BLOB_PORT=10000

LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.76.1-stable
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=tap-local-master-key
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_ATHENA_EMBEDDING_MODEL=dashscope/text-embedding-v4
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Optional direct paid embedding research; Athena and LiteLLM do not read these values.
LITELLM_EMBEDDING_MODEL=text-embedding-v4
LITELLM_EMBEDDING_API_KEY=
LITELLM_EMBEDDING_API_BASE=

MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=default
MILVUS_MINIO_ROOT_USER=tap-local-minio
MILVUS_MINIO_ROOT_PASSWORD=tap-local-minio-password
MILVUS_INITIAL_ROOT_PASSWORD=Milvus
MILVUS_ROOT_PASSWORD=tap-local-Root1!
TAP_ALLOW_INITIAL_MILVUS_ROOT=0
MILVUS_READER_USERNAME=tap_reader
MILVUS_READER_PASSWORD=tap-local-Reader1!
MILVUS_WRITER_USERNAME=tap_writer
MILVUS_WRITER_PASSWORD=tap-local-Writer1!
MILVUS_PROVISIONER_USERNAME=tap_provisioner
MILVUS_PROVISIONER_PASSWORD=tap-local-Provisioner1!

# One strict Athena runtime settings snapshot shared by API, relay, and worker
TAP_ATHENA_COMPOSE_PROJECT=tap-athena-demo
TAP_ALLOW_ATHENA_VOLUME_RESET=0
TAP_DATABASE_URL=mysql+asyncmy://tap:tap@127.0.0.1:3306/tap?charset=utf8mb4
TAP_ALEMBIC_DATABASE_URL=mysql+pymysql://tap:tap@127.0.0.1:3306/tap?charset=utf8mb4
TAP_REDIS_URL=redis://127.0.0.1:6379/0
TAP_REDIS_COMMAND_STREAM=tap:commands
AZURE_STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;'

ATHENA_API_HOST=127.0.0.1
ATHENA_API_PORT=8000
ATHENA_WEB_HOST=127.0.0.1
ATHENA_WEB_PORT=5173
ATHENA_MODEL_BACKEND=litellm
ATHENA_ANSWER_BACKEND=litellm
ATHENA_CODEX_MODEL=gpt-5.6-sol
ATHENA_CODEX_REASONING_EFFORT=ultra
ATHENA_CODEX_TIMEOUT_SECONDS=300
TAP_DEMO_MODE=

# Codex uses local ChatGPT login; it does not require OPENAI_API_KEY or CODEX_API_KEY.
# Codex is a local CLI entrypoint: query and selected Evidence are sent to OpenAI.
# Embedding content is sent to Alibaba Bailian and requires DASHSCOPE_API_KEY.

ATHENA_COLLECTION=kb_doc_v1_athena_demo
ATHENA_ALIAS=kb_doc_athena_demo_active
ATHENA_CORPUS_VERSION=athena-demo-v1
ATHENA_CHAT_ALIAS=athena-chat
ATHENA_EMBEDDING_ALIAS=athena-embedding
ATHENA_RETRIEVAL_PROFILE=quick-hybrid-v1
ATHENA_EMBEDDING_DIMENSION=1536
ATHENA_INDEX_VERSION=athena-index-v1
ATHENA_PIPELINE_VERSION=athena-ingestion-v1

ATHENA_WORKER_ID=athena-local-worker
ATHENA_POLL_SECONDS=1
ATHENA_JOB_BATCH_SIZE=10
TAP_RELAY_POLL_SECONDS=1
TAP_RELAY_BATCH_SIZE=100

ATHENA_READY_TIMEOUT_SECONDS=2
ATHENA_MODEL_TIMEOUT_SECONDS=15
ATHENA_BLOB_TIMEOUT_SECONDS=15
ATHENA_MILVUS_TIMEOUT_SECONDS=10

DOCKER_CHECK_TIMEOUT_SECONDS=30
