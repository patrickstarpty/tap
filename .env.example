# Copy this file to .env for the loopback-only Tapper local demo.
# Never commit .env or replace these local-only defaults with production credentials.
# demo-up/demo-check/demo-dev/demo-e2e source .env as Bash; keep values shell-compatible.

# LiteLLM gateway -> Bailian workspace (DASHSCOPE_API_KEY and API_BASE are required)
# LITELLM_PORT and LITELLM_BASE_URL are one endpoint and must change together.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.87.0
LITELLM_PORT=24000
LITELLM_BASE_URL=http://127.0.0.1:24000
LITELLM_MASTER_KEY=tap-local-master-key
DASHSCOPE_API_KEY=
# Replace ws-your-workspace-id with your own Beijing Bailian Workspace ID.
DASHSCOPE_API_BASE=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Reference only: changing these two values does not configure Tapper or LiteLLM.
DASHSCOPE_API_HOST=ws-your-workspace-id.cn-beijing.maas.aliyuncs.com
DASHSCOPE_NATIVE_API_BASE=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1

# MySQL middleware and both host-process URLs
# MYSQL_PORT/user/password/database and both URLs describe one service; change them together.
MYSQL_IMAGE=mysql:8.4.6
MYSQL_PORT=23306
MYSQL_ROOT_PASSWORD=tap-root
MYSQL_DATABASE=tap
MYSQL_USER=tap
MYSQL_PASSWORD=tap
TAP_DATABASE_URL=mysql+asyncmy://tap:tap@127.0.0.1:23306/tap?charset=utf8mb4
TAP_ALEMBIC_DATABASE_URL=mysql+pymysql://tap:tap@127.0.0.1:23306/tap?charset=utf8mb4

# TAP Insights ClickHouse projection. Admin is bootstrap-only; workers use writer,
# APIs use reader. Keep the HTTP port loopback-only and rotate every non-local value.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.33.6-alpine
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_ADMIN_USER=tap_insights_admin
CLICKHOUSE_ADMIN_PASSWORD=tap-local-insights-admin
TAP_CLICKHOUSE_URL=http://127.0.0.1:28123/?database=tap_insights
TAP_CLICKHOUSE_WRITER_USER=tap_insights_writer
TAP_CLICKHOUSE_WRITER_PASSWORD=tap-local-insights-writer
TAP_CLICKHOUSE_READER_USER=tap_insights_reader
TAP_CLICKHOUSE_READER_PASSWORD=tap-local-insights-reader
TAP_INSIGHTS_MAX_ROWS_TO_READ=1000000
TAP_INSIGHTS_MAX_BYTES_TO_READ=268435456
TAP_INSIGHTS_MAX_MEMORY_BYTES=268435456
TAP_INSIGHTS_MAX_CONCURRENT_QUERIES=10
TAP_INSIGHTS_MAX_OUTPUT_ROWS=10000
TAP_INSIGHTS_MAX_OUTPUT_BYTES=4194304
TAP_INSIGHTS_QUERY_TIMEOUT_SECONDS=3

# Optional loopback UAT credentials. Set all fields in each group together,
# using private, expiring values outside this example. The browser prompts for
# the TAP_REPORT project ID and token; TAP AI keeps delegated credentials server-side.
# TAP_REPORT_ACCESS_TOKEN=<private-random-token-at-least-16-characters>
# TAP_REPORT_PROJECT_ID=tapper-demo
# TAP_REPORT_TOKEN_EXPIRES_AT=2026-10-01T00:00:00+00:00
# TAP_INSIGHTS_DELEGATED_USER_TOKEN=<private-delegated-user-token>
# TAP_INSIGHTS_SERVICE_TOKEN=<private-service-token>
# TAP_INSIGHTS_DELEGATED_PROJECT_ID=tapper-demo
# TAP_INSIGHTS_DELEGATED_EXPIRES_AT=2026-10-01T00:00:00+00:00
# TAP_INSIGHTS_AUTHORIZATION_VERSION=authz-1
# TAP_INSIGHTS_BASE_URL=http://127.0.0.1:8001
# TAP_INSIGHTS_MAX_MICROS_PER_TOKEN=100
# Tapper enables report explanations only when these two values and all five
# TAP_INSIGHTS_DELEGATED_* / SERVICE_TOKEN / AUTHORIZATION_VERSION values are set.
# The per-token value is an operator-supplied upper price ceiling for admission,
# not a measured model charge; use the approved model route's current pricing.

# Redis middleware and host-process URL
# REDIS_PORT and TAP_REDIS_URL must change together.
REDIS_IMAGE=redis:7.4.7
REDIS_PORT=26379
TAP_REDIS_URL=redis://127.0.0.1:26379/0
TAP_REDIS_COMMAND_STREAM=tap:commands
# A dedicated connection pool for blocking `XREAD BLOCK` SSE reads, separate
# from the general-purpose Redis client. `read()` clamps its `block_ms` to
# this socket_timeout minus a 2s margin, so a BLOCK window never races the
# socket timeout; it no longer needs to be set above every caller's window
# by hand. Size the pool for concurrent SSE readers.
TAP_REDIS_STREAM_SOCKET_TIMEOUT_SECONDS=20
TAP_REDIS_STREAM_POOL_SIZE=50

# Milvus middleware, MinIO storage, bootstrap, and role credentials
# MILVUS_PORT and MILVUS_URI must change together.
# milvus-bootstrap/milvus-health/test-milvus require these values to be exported explicitly.
MILVUS_PORT=39530
MILVUS_HEALTH_PORT=29091
MILVUS_URI=http://127.0.0.1:39530
MILVUS_DATABASE=default
MILVUS_MINIO_ROOT_USER=tap-local-minio
MILVUS_MINIO_ROOT_PASSWORD=tap-local-minio-password
MILVUS_INITIAL_ROOT_PASSWORD=Milvus
MILVUS_ROOT_PASSWORD=tap-local-Root1!
# Keep this at 0 in .env; enable initial-root recovery only on the one approved command.
TAP_ALLOW_INITIAL_MILVUS_ROOT=0
MILVUS_READER_USERNAME=tap_reader
MILVUS_READER_PASSWORD=tap-local-Reader1!
MILVUS_WRITER_USERNAME=tap_writer
MILVUS_WRITER_PASSWORD=tap-local-Writer1!
MILVUS_PROVISIONER_USERNAME=tap_provisioner
MILVUS_PROVISIONER_PASSWORD=tap-local-Provisioner1!

# Compose identity and destructive-operation safe defaults
# Make takes project/reset approval from the command line; do not enable reset in .env.
TAP_TAPPER_COMPOSE_PROJECT=tap-tapper-demo
TAP_ALLOW_TAPPER_VOLUME_RESET=0

# Tapper loopback processes and model mode
TAPPER_API_HOST=127.0.0.1
TAPPER_API_PORT=8000
TAPPER_WEB_HOST=127.0.0.1
TAPPER_WEB_PORT=5173
TAPPER_MODEL_BACKEND=litellm
# "fake" is for tests only (deterministic rule-based extraction); use "model" otherwise.
# Each mode has its own extraction profile; switching re-extracts every published
# source the next time the graph worker starts.
TAPPER_GRAPH_EXTRACTION_MODE=model
# Graph extraction batches close at about TAPPER_GRAPH_BATCH_CHARS characters
# (500-50000; one longer chunk is sent alone); TAPPER_GRAPH_BATCH_SIZE (1-200)
# only caps the chunk count when a document is split into many tiny chunks.
# Each batch may return at most 40 nodes and 60 edges, sized for about 3000
# characters of dense clauses within the 8192-token extraction budget.
TAPPER_GRAPH_BATCH_CHARS=3000
TAPPER_GRAPH_BATCH_SIZE=100
TAPPER_GRAPH_BATCH_RETRIES=3
# One graph extraction call's own deadline (seconds, at most 300) and completion
# budget (1024-32768 tokens); other model calls keep TAPPER_MODEL_TIMEOUT_SECONDS
# and the 2048-token structured default. The deadline must allow at least one
# second per 40 output tokens (8192 tokens need >= 205 s).
TAPPER_GRAPH_EXTRACTION_TIMEOUT_SECONDS=240
TAPPER_GRAPH_EXTRACTION_MAX_TOKENS=8192
# Graph extraction jobs (one document revision each) a graph worker runs at once
# (1-16); a job's own batches stay sequential.
TAPPER_GRAPH_WORKER_CONCURRENCY=4
TAPPER_GRAPH_ALIGN_EMBEDDING=0
TAPPER_GRAPH_ALIGN_THRESHOLD=0.92
# Skip level-3 embedding alignment (pairwise, matrix-indexed, run off the event
# loop) above this many candidate nodes in one merge; levels 1-2 still run.
# Range 1-20000.
TAPPER_GRAPH_ALIGN_EMBEDDING_MAX_NODES=2000
TAPPER_GRAPH_OVERVIEW_LIMIT=150
# Supplement retrieval with up to 5 authorized neighbor-node chunks surfaced by relation analysis (0/1).
TAPPER_GRAPH_RETRIEVAL_AUGMENT=1
# Run the relation analysis agent subgraph for answers (0/1); set 0 only as a rollback.
TAPPER_GRAPH_REASONING=1
TAP_DEMO_MODE=

# All document/query Embedding content is sent to Alibaba Bailian via text-embedding-v4,
# requires DASHSCOPE_API_KEY, and remains text-embedding-v4 at dimension 1536.

# Model roles: LiteLLM model names from deploy/local/litellm/config.yaml.
# Changing TAPPER_EMBEDDING_MODEL requires rebuilding the Milvus index.
# An empty TAPPER_VISION_MODEL disables flowchart recognition.
TAPPER_DEFAULT_CHAT_MODEL=qwen-plus
TAPPER_EMBEDDING_MODEL=text-embedding-v4
TAPPER_VISION_MODEL=qwen3-vl-plus

# Fixed Tapper demo contract; these values are validated, not general tuning knobs.
TAPPER_SCHEMA_VERSION=doc-schema-v2
TAPPER_COLLECTION=kb_doc_v2_tapper_demo
TAPPER_ALIAS=kb_doc_tapper_demo_active
TAPPER_CORPUS_VERSION=tapper-demo-v2
TAPPER_RETRIEVAL_PROFILE=quick-hybrid-v1
TAPPER_EMBEDDING_DIMENSION=1536
TAPPER_INDEX_VERSION=tapper-index-v1
TAPPER_PIPELINE_VERSION=tapper-ingestion-v1

# Worker and relay controls
TAPPER_WORKER_ID=tapper-local-worker
TAPPER_POLL_SECONDS=1
TAPPER_JOB_BATCH_SIZE=10
# Maximum times a chat Turn may be claimed (1..10) before it is settled as failed
# instead of being retried again.
TAPPER_TURN_MAX_ATTEMPTS=3
# Per-turn guardrail budget: max tool rounds (1..20), max wall-clock seconds
# (10..1800), max model calls (1..50), and max cost in micros-USD (0..100000000;
# 0 means unbounded).
TAPPER_TURN_MAX_TOOL_ROUNDS=6
TAPPER_TURN_MAX_SECONDS=180
TAPPER_TURN_MAX_MODEL_CALLS=10
TAPPER_TURN_MAX_COST_MICROS=0
# On SIGTERM/SIGINT the graph worker stops claiming and gives running jobs this
# many seconds (max 300) to finish, then cancels them and releases their leases.
TAPPER_WORKER_SHUTDOWN_GRACE_SECONDS=10
TAP_RELAY_POLL_SECONDS=1
TAP_RELAY_BATCH_SIZE=100

# Tapper dependency deadlines
TAPPER_READY_TIMEOUT_SECONDS=2
TAPPER_MODEL_TIMEOUT_SECONDS=15
# Vision extraction has a separate bound; chat and embedding retain the model timeout.
TAPPER_VISION_TIMEOUT_SECONDS=60
TAPPER_BLOB_TIMEOUT_SECONDS=15
TAPPER_S3_ENDPOINT=http://127.0.0.1:19000
TAPPER_S3_BUCKET=tapper-objects
TAPPER_S3_REGION=us-east-1
TAPPER_S3_ACCESS_KEY=tap-local-object-key
TAPPER_S3_SECRET_KEY=tap-local-object-password
TAPPER_S3_STORE_ID=tapper-local
TAPPER_S3_PORT=19000
TAPPER_MILVUS_TIMEOUT_SECONDS=10

# Legacy generic middleware checker only; make demo-check does not read this value.
DOCKER_CHECK_TIMEOUT_SECONDS=30

# Optional direct paid Bailian embedding research; Tapper Demo does not read these values.
# These historical LITELLM_* names call Bailian directly and do not pass through LiteLLM.
# make research-embeddings currently requires explicit export/source plus its paid-run opt-in.
LITELLM_EMBEDDING_MODEL=text-embedding-v4
LITELLM_EMBEDDING_API_KEY=
LITELLM_EMBEDDING_API_BASE=

# Optional local Langfuse ops dashboard. Tapper always records traces to MySQL;
# Langfuse reuses the insights ClickHouse, main Redis (db 1), and tap-minio.
# Start it with:
#   make langfuse-up
# then uncomment LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY below and restart the TAP AI processes.
LANGFUSE_IMAGE=langfuse/langfuse:3.225.11
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:3.225.11
LANGFUSE_POSTGRES_IMAGE=postgres:17-alpine
LANGFUSE_PORT=23000
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=tap_langfuse
LANGFUSE_POSTGRES_PASSWORD=tap-local-langfuse-postgres
LANGFUSE_CLICKHOUSE_USER=tap_langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=tap-local-langfuse
LANGFUSE_NEXTAUTH_SECRET=tap-local-langfuse-nextauth-secret
LANGFUSE_SALT=tap-local-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=6ff714a074e50e47ef0fec2d8a891ce2626d8208df40c6a7066acce50615901e
LANGFUSE_INIT_ORG_ID=tap-local-org
LANGFUSE_INIT_PROJECT_ID=tap-local-project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-example
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-example
LANGFUSE_INIT_USER_EMAIL=tap-local-admin@example.com
LANGFUSE_INIT_USER_PASSWORD=tap-local-langfuse-admin
# LANGFUSE_HOST=http://127.0.0.1:23000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-example
# LANGFUSE_SECRET_KEY=sk-lf-local-example
TAP_LANGFUSE_SYNC_SETTLE_SECONDS=60
TAP_LANGFUSE_ENVIRONMENT=local
# TAP_TRACE_REDACTION_RULES=deploy/local/redaction/custom-rules.example.yaml

# Optional generic OTLP trace export; independent of Langfuse, point it at any
# OTLP collector endpoint you run yourself.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
