# Copy this file to .env for the loopback-only Tapper local demo.
# Never commit .env or replace these local-only defaults with production credentials.
# demo-up/demo-check/demo-dev/demo-e2e source .env as Bash; keep values shell-compatible.

# LiteLLM gateway -> Bailian workspace (DASHSCOPE_API_KEY and API_BASE are required)
# LITELLM_PORT and LITELLM_BASE_URL are one endpoint and must change together.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.87.0
LITELLM_PORT=24000
LITELLM_BASE_URL=http://127.0.0.1:24000
LITELLM_MASTER_KEY=tap-local-master-key
LITELLM_MODEL=dashscope/qwen-plus
LITELLM_TAPPER_EMBEDDING_MODEL=dashscope/text-embedding-v4
DASHSCOPE_API_KEY=
# Replace ws-your-workspace-id with your own Beijing Bailian Workspace ID.
DASHSCOPE_API_BASE=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Reference only: changing these two values does not configure Tapper or LiteLLM.
DASHSCOPE_API_HOST=ws-your-workspace-id.cn-beijing.maas.aliyuncs.com
DASHSCOPE_NATIVE_API_BASE=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1

# MySQL middleware and both host-process URLs
# MYSQL_PORT/user/password/database and both URLs describe one service; change them together.
MYSQL_IMAGE=mysql:8.4.6
MYSQL_PORT=23306
MYSQL_ROOT_PASSWORD=tap-root
MYSQL_DATABASE=tap
MYSQL_USER=tap
MYSQL_PASSWORD=tap
TAP_DATABASE_URL=mysql+asyncmy://tap:tap@127.0.0.1:23306/tap?charset=utf8mb4
TAP_ALEMBIC_DATABASE_URL=mysql+pymysql://tap:tap@127.0.0.1:23306/tap?charset=utf8mb4

# Redis middleware and host-process URL
# REDIS_PORT and TAP_REDIS_URL must change together.
REDIS_IMAGE=redis:7.4.7
REDIS_PORT=26379
TAP_REDIS_URL=redis://127.0.0.1:26379/0
TAP_REDIS_COMMAND_STREAM=tap:commands

# Azurite Blob middleware and host-process connection string
# AZURITE_BLOB_PORT and BlobEndpoint must change together.
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.35.0
AZURITE_BLOB_PORT=21000
AZURE_STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:21000/devstoreaccount1;'

# Milvus middleware, MinIO storage, bootstrap, and role credentials
# MILVUS_PORT and MILVUS_URI must change together.
# milvus-bootstrap/milvus-health/test-milvus require these values to be exported explicitly.
MILVUS_PORT=39530
MILVUS_HEALTH_PORT=29091
MILVUS_URI=http://127.0.0.1:39530
MILVUS_DATABASE=default
MILVUS_MINIO_ROOT_USER=tap-local-minio
MILVUS_MINIO_ROOT_PASSWORD=tap-local-minio-password
MILVUS_INITIAL_ROOT_PASSWORD=Milvus
MILVUS_ROOT_PASSWORD=tap-local-Root1!
# Keep this at 0 in .env; enable initial-root recovery only on the one approved command.
TAP_ALLOW_INITIAL_MILVUS_ROOT=0
MILVUS_READER_USERNAME=tap_reader
MILVUS_READER_PASSWORD=tap-local-Reader1!
MILVUS_WRITER_USERNAME=tap_writer
MILVUS_WRITER_PASSWORD=tap-local-Writer1!
MILVUS_PROVISIONER_USERNAME=tap_provisioner
MILVUS_PROVISIONER_PASSWORD=tap-local-Provisioner1!

# Compose identity and destructive-operation safe defaults
# Make takes project/reset approval from the command line; do not enable reset in .env.
TAP_TAPPER_COMPOSE_PROJECT=tap-tapper-demo
TAP_ALLOW_TAPPER_VOLUME_RESET=0

# Tapper loopback processes and model mode
TAPPER_API_HOST=127.0.0.1
TAPPER_API_PORT=8000
TAPPER_WEB_HOST=127.0.0.1
TAPPER_WEB_PORT=5173
TAPPER_MODEL_BACKEND=litellm
TAPPER_ANSWER_BACKEND=litellm
TAPPER_CODEX_MODEL=gpt-5.6-sol
TAPPER_CODEX_REASONING_EFFORT=ultra
TAPPER_CODEX_TIMEOUT_SECONDS=300
TAP_DEMO_MODE=

# Codex is exact native 0.149.0 + gpt-5.6-sol + ultra, one agent and no tools.
# Codex uses local ChatGPT login; it does not require OPENAI_API_KEY or CODEX_API_KEY.
# The selected answer backend is exclusive: Codex and LiteLLM never fall back to each other.
# Any CLI/login/feature/request-owned catalog entry-schema drift fails as answer-unavailable.
# Codex is a local CLI entrypoint: query and selected Evidence are sent to OpenAI.
# All document/query Embedding content is sent to Alibaba Bailian via tapper-embedding,
# requires DASHSCOPE_API_KEY, and remains text-embedding-v4 at dimension 1536.

# Fixed Tapper demo contract; these values are validated, not general tuning knobs.
TAPPER_COLLECTION=kb_doc_v1_tapper_demo
TAPPER_ALIAS=kb_doc_tapper_demo_active
TAPPER_CORPUS_VERSION=tapper-demo-v1
TAPPER_CHAT_ALIAS=tapper-chat
TAPPER_EMBEDDING_ALIAS=tapper-embedding
TAPPER_RETRIEVAL_PROFILE=quick-hybrid-v1
TAPPER_EMBEDDING_DIMENSION=1536
TAPPER_INDEX_VERSION=tapper-index-v1
TAPPER_PIPELINE_VERSION=tapper-ingestion-v1

# Worker and relay controls
TAPPER_WORKER_ID=tapper-local-worker
TAPPER_POLL_SECONDS=1
TAPPER_JOB_BATCH_SIZE=10
TAP_RELAY_POLL_SECONDS=1
TAP_RELAY_BATCH_SIZE=100

# Tapper dependency deadlines
TAPPER_READY_TIMEOUT_SECONDS=2
TAPPER_MODEL_TIMEOUT_SECONDS=15
TAPPER_BLOB_TIMEOUT_SECONDS=15
TAPPER_MILVUS_TIMEOUT_SECONDS=10

# Legacy generic middleware checker only; make demo-check does not read this value.
DOCKER_CHECK_TIMEOUT_SECONDS=30

# Optional direct paid Bailian embedding research; Tapper Demo does not read these values.
# These historical LITELLM_* names call Bailian directly and do not pass through LiteLLM.
# make research-embeddings currently requires explicit export/source plus its paid-run opt-in.
LITELLM_EMBEDDING_MODEL=text-embedding-v4
LITELLM_EMBEDDING_API_KEY=
LITELLM_EMBEDDING_API_BASE=
