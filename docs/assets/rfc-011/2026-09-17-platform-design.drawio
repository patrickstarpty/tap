        <mxCell id="author" value="录制 / 手工 / AI 生成&#10;左：步骤，中：应用，右：参数&#10;保存定位、变量与检查条件&#10;固定步骤 / 动态 AI 块分开" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="370" height="145" as="geometry" />
