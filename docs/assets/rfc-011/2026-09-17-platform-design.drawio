        </mxCell>
        <mxCell id="approve" value="独立复核当前版本&#10;复核人与本版编校人员分离&#10;批准绑定内容、来源与适用范围" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="index" value="冻结批准清单并建立索引&#10;文字 / 图像 / 关系全部就绪&#10;未完成时不切换正式版本" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="100" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rework" value="退回或变更后重新核对&#10;修改记录与差异保留&#10;条件、公式与关系依赖一起复核" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="365" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="retrieval" value="正式检索与再次核验&#10;仅取已发布、有效、有权的切片&#10;补上下文、图表查询同样检查" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="365" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="release" value="发布当前有效版本&#10;MySQL 发布清单控制可见范围&#10;撤回立即停用并清缓存" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="365" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="记录采纳与纠错&#10;原样采纳 / 修改后采纳 / 拒绝&#10;纠错进入草稿，不自动变成知识" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
