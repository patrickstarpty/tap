          <mxGeometry x="1420" y="100" width="370" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ai" value="TAP AI + LangGraph&#10;已批准知识与用例 + 真实界面&#10;LiteLLM 生成 / 提出修复建议&#10;不改变已确认业务预期" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
