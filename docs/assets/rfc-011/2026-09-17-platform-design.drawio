        <mxCell id="review" value="知识库内核对与审批&#10;原件与结果对照，修正或重试&#10;严格模式由独立人员复核" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="370" width="370" height="145" as="geometry" />
        </mxCell>
        <mxCell id="visible" value="按审核规则发布可检索版本&#10;同一版本的各路索引就绪&#10;严格模式缺关键内容不能发布" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
