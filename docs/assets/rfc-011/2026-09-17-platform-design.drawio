  <diagram id="2026-09-17-knowledge-human-review" name="知识切片人工审核">
    <mxGraphModel dx="1850" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="draft" value="解析草稿与原件&#10;完整条款 / 表格规则 / 流程分支&#10;来源位置、条件、例外不拆散" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edit" value="业务人员核对与标注&#10;修正文字、数值、单位、关系&#10;疑点未解决不能提交批准" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.5;fontColor=#222222;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1">
