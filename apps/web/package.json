{
  "name": "@tap/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "contracts": "node scripts/generate-api.mjs",
    "contracts:check": "node scripts/generate-api.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "architecture": "node scripts/check-architecture.mjs",
    "check": "corepack pnpm run lint && corepack pnpm run format:check && corepack pnpm run architecture && corepack pnpm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@tanstack/react-query": "5.102.7",
    "antd": "6.6.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0"
  }
